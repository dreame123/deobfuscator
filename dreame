@echo off
:: Ensure the script is running with administrative privileges
NET SESSION >nul 2>&1
IF %ERRORLEVEL% NEQ 0 (
    echo [ERROR] Please right-click this script and select "Run as administrator".
    pause
    exit /b
)

echo =======================================================
echo 1. Installing Python and Node.js via WinGet...
echo =======================================================
:: --accept-package-agreements bypasses interactive license prompts
winget install --id Python.Python.3 --silent --accept-package-agreements --accept-source-agreements
winget install --id OpenJS.NodeJS --silent --accept-package-agreements --accept-source-agreements

echo.
echo =======================================================
echo 2. Downloading Microsoft .NET Installation Script...
echo =======================================================
set "DOTNET_SCRIPT=%TEMP%\dotnet-install.ps1"
powershell -Command "Invoke-WebRequest -Uri 'https://dot.net' -OutFile '%DOTNET_SCRIPT%'"

echo.
echo =======================================================
echo 3. Installing .NET 8 and .NET 9 Runtimes...
echo =======================================================
:: --skip-non-versioned-files prevents older runtime files from overwriting newer ones
powershell -ExecutionPolicy Bypass -File "%DOTNET_SCRIPT%" -Channel 8.0 -Runtime dotnet -SkipNonVersionedFiles
powershell -ExecutionPolicy Bypass -File "%DOTNET_SCRIPT%" -Channel 9.0 -Runtime dotnet -SkipNonVersionedFiles

echo.
echo =======================================================
echo Setup complete! Please restart your command prompt or PC.
echo =======================================================
pause

